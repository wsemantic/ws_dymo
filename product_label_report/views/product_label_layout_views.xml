<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="product_label_layout_view_form_stock_quantity" model="ir.ui.view">
        <field name="name">product.label.layout.stock.quantity.form</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_format']" position="after">
                <field name="use_stock_quantity" />
                <field name="company_id" invisible="1" />
                <field name="warehouse_id" required="use_stock_quantity" invisible="not use_stock_quantity" />
            </xpath>
            <xpath expr="//field[@name='custom_quantity']" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="readonly">use_stock_quantity</attribute>
                <attribute name="required">not use_stock_quantity</attribute>
            </xpath>
        </field>
    </record>
</odoo>
