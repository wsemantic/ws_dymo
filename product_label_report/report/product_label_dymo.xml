<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_simple_label_dymo" name="Report Label Dymo" inherit_id="product.report_simple_label_dymo">
        <!-- IMPORTANTE: este replace no es solo estetico, corrige un defecto de core.
             product.report_productlabel_dymo fija a fuego table_style con
             'width:100%;height:32mm;' y lo aplica inline a este div, sin mirar el
             paperformat. En un rollo que no mida exactamente 32mm eso desborda
             (32mm de caja + 2mm x2 de padding_page = 36mm de contenido) y el
             sobrante empuja a la pagina siguiente, con lo que el margen superior
             baila etiqueta si, etiqueta no. Al ir inline no hay forma de corregirlo
             desde el scss ni desde la configuracion: hay que sustituir el div.
             Si se desinstala este modulo, vuelve el problema. -->
        <xpath expr="//div[hasclass('o_label_full')]" position="replace">
            <!-- No usamos table_style: core inyecta ahi un height:32mm inline que,
                 sumado al padding de 2mm del contenedor, da 36mm de contenido y
                 desborda cualquier rollo mas corto (con 30mm el sobrante pasaba a
                 la pagina siguiente y el margen superior alternaba etiqueta si,
                 etiqueta no). Al ser inline ganaba a todo el scss. -->
            <div class="o_label_full" style="width: 100%; max-height: 100%; overflow: hidden;">
                <t t-set="barcode_value" t-value="barcode or product.barcode"/>
                <t t-set="name_val" t-value="product.name or ''"/>
                <!-- Nombre sin los valores de variante ni codigo interno: el codigo ya va
                     bajo las barras en pequeno, y color y talla se imprimen aparte.
                     El nombre ya no acompana al codigo aqui: iba en una sola linea sin
                     wrap y se recortaba. Ahora baja a la columna derecha de la tabla,
                     encima del precio, donde dispone de dos lineas -->
                <div class="text-start o_label_small_barcode" style="padding: 0;">
                    <t t-if="barcode_value">
                        <div t-out="barcode_value" style="padding:0" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                    </t>
                </div>
                <!-- Product Name Fallback (if no barcode) -->
                <div t-if="not barcode_value" class="o_label_name" style="line-height: 100%; background-color: transparent; height: auto; max-height: 2.2em; padding: 0;">
                    <span t-out="('[%s] %s' % (product.default_code, product.name)) if product.default_code else (product.name or '')"/>
                </div>
                <!-- El nombre va en su propio bloque, no dentro del td del precio: el
                     overflow:hidden no recorta de forma fiable dentro de una celda en
                     wkhtmltopdf y el sobrante acababa montandose sobre el precio. Como
                     bloque hermano encima de la tabla queda arriba por posicion en el
                     flujo y no puede invadirlo. Dos lineas a todo el ancho -->
                <!-- Valores de variante: la talla manda, el color acompana en pequeno -->
                <t t-set="variant_vals" t-value="product.product_template_attribute_value_ids if product.is_product_variant else product.env['product.template.attribute.value']"/>
                <t t-set="size_vals" t-value="variant_vals.filtered(lambda l: l.attribute_id.attribute_type == 'size')"/>
                <t t-set="color_vals" t-value="variant_vals.filtered(lambda l: l.attribute_id.attribute_type == 'color')"/>
                <!-- Sin attribute_type configurado el valor cae en la linea pequena -->
                <t t-set="other_vals" t-value="variant_vals.filtered(lambda l: not l.attribute_id.attribute_type)"/>
                <t t-set="size_val" t-value="size_vals[0].name if size_vals else ''"/>
                <t t-set="color_val" t-value="', '.join((color_vals + other_vals).mapped('name'))"/>
                <t t-set="color_val" t-value="color_val if len(color_val) &lt;= 12 else color_val[:12] + '…'"/>
                <!-- Sin margen superior: la tabla arranca con el codigo alfanumerico,
                     que va pegado a las barras. El margen existia cuando la primera
                     fila era la talla y se montaba sobre el codigo de barras -->
                <!-- table-layout: fixed es imprescindible: en modo auto el width de la
                     celda es solo una sugerencia y la tabla ensancha la columna para no
                     partir el texto, con lo que el nombre se quedaba en una linea y se
                     recortaba en vez de pasar a la segunda -->
                <table style="width: 100%; table-layout: fixed; margin-top: 0; padding-top: 0; border: 1px solid white; border-collapse: collapse;" cellspacing="0" cellpadding="0">
                    <!-- Una sola fila y dos celdas independientes, cada una apila lo
                         suyo: codigo + talla a la izquierda, nombre + precio a la
                         derecha. Antes era una rejilla de 3 filas con rowspan cruzados
                         (nombre en 1-2, talla en 2-3) y webkit repartia el alto
                         sobrante de cada rowspan entre sus filas, de modo que la fila
                         del precio tenia que absorber ademas la parte de la talla que
                         no cabia en la fila 2: la tabla salia mas alta que cualquiera
                         de las dos columnas y empujaba el color a la etiqueta
                         siguiente. Con dos celdas el alto es max(izquierda, derecha). -->
                    <tr>
                        <td style="border: 1px solid white; text-align: left; vertical-align: top; overflow: hidden;">
                            <!-- overflow y cuerpo reducido no son estetica: este span es
                                 el unico elemento que crece con el producto, y a tamano
                                 completo un EAN-13 desborda el ancho de esta columna
                                 (~24mm con table-layout:fixed). Ese desbordamiento
                                 activaba el encogimiento inteligente de wkhtmltopdf, que
                                 es un zoom sobre el ANCHO de toda la pagina: la etiqueta
                                 entera cambiaba de tamano segun la longitud del codigo. -->
                            <div class="product_barcode" t-out="barcode_value" style="font-size: .6em; word-break: break-all; padding: 0; margin: 0;"/>
                            <div t-if="size_val" class="attrib_val_size" t-attf-style="white-space: nowrap; line-height: 0.9; padding: 0; margin: 0; font-weight: bold; font-size: #{'3.4' if len(size_val) &lt;= 2 else '2.6' if len(size_val) &lt;= 4 else '1.8'}em;" t-esc="size_val"/>
                        </td>
                        <!-- Ancho fijo: es lo que hace que el nombre parta dentro de esta
                             columna y no invada la de la talla -->
                        <td style="border: 1px solid white; text-align: left; vertical-align: top; width: 65%;">
                            <!-- Alineado a la izquierda para separarlo del precio, que va
                                 a la derecha. Hasta tres lineas.
                                 El alto se reserva desde Python (_label_name_height):
                                 los caracteres por linea de ese calculo salen del ancho
                                 de ESTA columna (65% ~ 34mm), no del ancho de la
                                 etiqueta. Si se cambia el width del td hay que rehacer
                                 ese numero, o el texto se recorta en vez de pasar a la
                                 linea siguiente -->
                            <t t-set="name_height" t-value="product.env['product.label.name.fit']._label_name_height(name_val)"/>
                            <div t-if="name_val" class="product_barcode_name" t-attf-style="text-align: left; line-height: 1.05; height: #{name_height}em; overflow: hidden; white-space: normal; word-wrap: break-word; padding: 0; margin: 0;" t-out="name_val"/>
                            <!-- Margen superior: la cifra (.oe_currency_value a 1.3em sobre
                                 los 1.7em del strong) sobresale por arriba de su caja de
                                 linea y sin este hueco se monta sobre la ultima linea del
                                 nombre cuando el texto llega hasta el precio -->
                            <div style="white-space: nowrap; text-align: right; padding: 0; margin: 0.3em 0 0 0;">
                                <t t-if="product.is_product_variant">
                                    <strong class="o_label_price_medium" t-field="product.lst_price" t-options="{'widget': 'monetary', 'label_price': True}" style="font-size: 1.7em; display: inline-block;"/>
                                </t>
                                <t t-else="">
                                    <strong class="o_label_price_medium" t-field="product.list_price" t-options="{'widget': 'monetary', 'label_price': True}" style="font-size: 1.7em; display: inline-block;"/>
                                </t>
                            </div>
                        </td>
                    </tr>
                </table>
                <!-- Margen negativo: la caja de linea del precio (cifra a 2.2em) deja
                     aire bajo los digitos y el color quedaba demasiado separado de la talla -->
                <div t-if="color_val" class="attrib_val_color" t-attf-style="text-align: left; white-space: nowrap; overflow: hidden; line-height: 100%; padding: 0; margin-top: -0.3em; font-size: #{'100' if len(color_val) &lt;= 10 else '87'}%;" t-esc="color_val"/>
                <!-- Optional Extra HTML (currently disabled) -->
                <div t-if="False" class="o_label_extra_data">
                    <t t-out="extra_html"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
